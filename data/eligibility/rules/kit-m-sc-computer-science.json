    {
      "id": "degree",
      "label": "Bachelor's in Computer Science or essentially the same content, at least 3 years",
      "severity": "hard",
      "check": {
        "type": "university_review",
        "note": "KIT decides whether the degree is Computer Science or essentially the same content (R01)."
      },
      "citations": [
        {
          "doc_id": "de/kit/cs-msc/programme",
          "quote": "The degree program must have been completed within a standard period of study of at least three years and with a minimum number of 180 ECTS credits."
        }
      ],
      "reviewed_by": "pending"
    },
    {
      "id": "degree_ects",
      "label": "At least 180 ECTS credits in the first degree (credits in another unit: KIT decides)",
      "check": {
        "type": "any_of",
        "children": [
          {
            "type": "all_of",
            "children": [
              {
                "type": "in",
                "fact": "credit_unit",
                "values": [
                  "ECTS"
                ]
              },
              {
                "type": "min",
                "fact": "total_credits",
                "value": "180"
              }
            ]
          },
          {
            "type": "all_of",
            "children": [
              {
                "type": "in",
                "fact": "credit_unit",
                "values": [
                  "ECTS"
                ],
                "negate": true
              },
              {
                "type": "university_review",
                "note": "Your credits are not in ECTS. The engine does not convert credit units; KIT decides whether your credits meet the 180 ECTS minimum."
              }
            ]
          }
        ]
      },
      "citations": [
        {
          "doc_id": "de/kit/cs-msc/programme",
          "quote": "The degree program must have been completed within a standard period of study of at least three years and with a minimum number of 180 ECTS credits."
        }
