        {
          "doc_id": "de/kit/cs-msc/programme",
          "quote": "a successful Graduate Aptitude Test in Engineering (GATE) in the field of Computer Science and Information Technology or Data Science and Artificial Intelligence"
        }
      ],
      "reviewed_by": "human"
    },
    {
