# Copy to .env and fill in what you have. The whole app runs without any of these:
# no key -> extractive answer mode, vector_backend=memory -> no Qdrant server needed.

# OpenAI key for the LLM answer path. Leave empty to use the extractive fallback.
OPENAI_API_KEY=

# Only used when retrieval.vector_backend is "qdrant" (containerization phase).
QDRANT_URL=http://localhost:6333

# Override the vector backend from config/settings.yaml: memory | qdrant
VECTOR_BACKEND=

# Model overrides (defaults live in config/settings.yaml)
LLM_MODEL=
EMBED_MODEL=
RERANK_MODEL=
