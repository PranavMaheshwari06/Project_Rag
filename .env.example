# Copy to .env and fill in what you have. The whole app runs without any of these:
# no key -> extractive answer mode, vector_backend=memory -> no Qdrant server needed.

# Gemini API key for the LLM answer path. Leave empty to use the extractive fallback.
GEMINI_API_KEY=

# Only used when retrieval.vector_backend is "qdrant" (containerization phase).
QDRANT_URL=http://localhost:6333

# Override the vector backend from config/settings.yaml: memory | qdrant
VECTOR_BACKEND=

# Model overrides (defaults live in config/settings.yaml)
LLM_MODEL=
EMBED_MODEL=
RERANK_MODEL=

# For a public instance (defaults live in core/config.py).
# Enables /ingest and /evaluate behind this bearer token; empty = those routes do not exist.
ADMIN_TOKEN=
# Comma-separated browser origins allowed to call the API (default: the local UI).
CORS_ORIGINS=
# Global ceiling on language-model requests per UTC day (default 300).
DAILY_LLM_CALL_CAP=
# Header in which a proxy you control passes the client address (for example CF-Connecting-IP).
# Behind a proxy and left empty, every visitor shares one rate limit. Never name a header a client can set.
CLIENT_IP_HEADER=
